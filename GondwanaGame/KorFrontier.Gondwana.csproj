<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>KorFrontier.Gondwana</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Gondwana" Version="2.*" />
    <PackageReference Include="Gondwana.Hosting" Version="2.*" />
    <PackageReference Include="Gondwana.Avalonia" Version="2.*" />
    <PackageReference Include="Gondwana.Avalonia.Hosting" Version="2.*" />
    <PackageReference Include="Gondwana.Widgets" Version="2.*" />
    <PackageReference Include="Avalonia.Desktop" Version="11.*" />
  </ItemGroup>
</Project>
